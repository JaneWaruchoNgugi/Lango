# Copy to .env and fill in real values before running locally.
# Never commit a real .env file.

# Shared bearer token — must match OCR_SERVICE_TOKEN Firebase secret.
OCR_SERVICE_TOKEN=replace-with-64-char-random-string

# Set to true to return mock data without Tesseract (useful for demos).
OCR_DEMO_MODE=false

LOG_LEVEL=INFO

# Maximum image size the service will process (bytes). Default: 5 MB.
MAX_FILE_BYTES=5242880

# Tesseract processing timeout in seconds.
TESSERACT_TIMEOUT_SECONDS=20
