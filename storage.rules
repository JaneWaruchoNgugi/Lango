rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /properties/{propertyId}/{allPaths=**} {
      allow read: if request.auth != null &&
        (request.auth.token.role == 'SUPER_ADMIN' || request.auth.token.propertyId == propertyId);
      allow write: if request.auth != null &&
        (request.auth.token.role == 'SUPER_ADMIN' || request.auth.token.propertyId == propertyId);
    }
  }
}
