rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPER FUNCTIONS
    // ============================================================

    // Check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Get the role from custom claims (set server-side only)
    function getRole() {
      return request.auth.token.role;
    }

    // Get the propertyId from custom claims
    function getPropertyId() {
      return request.auth.token.propertyId;
    }

    // Role checks
    function isSuperAdmin() {
      return isAuth() && getRole() == 'SUPER_ADMIN';
    }

    function isPropertyManager() {
      return isAuth() && getRole() == 'PROPERTY_MANAGER';
    }

    function isCaretaker() {
      return isAuth() && getRole() == 'CARETAKER';
    }

    function isGuard() {
      return isAuth() && getRole() == 'SECURITY_GUARD';
    }

    // Property staff: manager or caretaker
    function isPropertyStaff() {
      return isPropertyManager() || isCaretaker();
    }

    // Any authenticated staff member
    function isAnyStaff() {
      return isSuperAdmin() || isPropertyManager() || isCaretaker() || isGuard();
    }

    // Check if user is authorized for this property
    function ownsProperty(propertyId) {
      return isSuperAdmin() || getPropertyId() == propertyId;
    }

    // Guard unit edits: only status + updatedAt may change
    function onlyStatusChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
    }

    // ============================================================
    // USERS
    // ============================================================
    // Only Super Admin can create/update users
    // Users can read their own profile only
    // Guards cannot read other users
    match /users/{userId} {
      allow read:   if isAuth() && (
        isSuperAdmin()
        || request.auth.uid == userId
        || isPropertyStaff()
        || (isSalonOwner() && resource.data.salonId == request.auth.token.salonId)
      );
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || request.auth.uid == userId;
      allow delete: if isSuperAdmin();
    }

    // ============================================================
    // PROPERTIES
    // ============================================================
    match /properties/{propertyId} {
      allow read:   if isAuth() && ownsProperty(propertyId);
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || (isPropertyStaff() && getPropertyId() == propertyId);
      allow delete: if isSuperAdmin();
    }

    // ============================================================
    // BLOCKS
    // ============================================================
    match /blocks/{blockId} {
      allow read:   if isAuth() && ownsProperty(resource.data.propertyId);
      allow create: if isSuperAdmin() || (isPropertyStaff() && getPropertyId() == request.resource.data.propertyId);
      allow update: if isSuperAdmin() || (isPropertyStaff() && getPropertyId() == resource.data.propertyId);
      allow delete: if isSuperAdmin();
    }

    // ============================================================
    // UNITS
    // ============================================================
    match /units/{unitId} {
      allow read:   if isAuth() && ownsProperty(resource.data.propertyId);
      allow create: if isSuperAdmin() || (isPropertyManager() && getPropertyId() == request.resource.data.propertyId);
      allow update: if isSuperAdmin()
                    || (isPropertyManager() && getPropertyId() == resource.data.propertyId)
                    || (isGuard() && getPropertyId() == resource.data.propertyId && onlyStatusChanged());
      allow delete: if isSuperAdmin();
    }

    // ============================================================
    // TENANTS
    // ============================================================
    // Caretakers and guards may read tenants for their property (read-only view).
    // Only property managers may create or modify tenant records.
    match /tenants/{tenantId} {
      allow read:   if isAuth() && ownsProperty(resource.data.propertyId);
      allow create: if isSuperAdmin() || (isPropertyManager() && getPropertyId() == request.resource.data.propertyId);
      allow update: if isSuperAdmin() || (isPropertyManager() && getPropertyId() == resource.data.propertyId);
      allow delete: if isSuperAdmin();
    }

    // ============================================================
    // OCCUPANCY HISTORY
    // ============================================================
    // Occupancy records link tenants to units; restrict to property managers and super admins.
    match /occupancies/{recordId} {
      allow read:   if isSuperAdmin() || (isPropertyManager() && getPropertyId() == resource.data.propertyId);
      allow create: if isSuperAdmin() || (isPropertyManager() && getPropertyId() == request.resource.data.propertyId);
      allow update: if isSuperAdmin() || (isPropertyManager() && getPropertyId() == resource.data.propertyId);
      allow delete: if isSuperAdmin();
    }

    // ============================================================
    // VISITORS
    // ============================================================
    // Guards can create and update visitors (check in/out)
    // Guards can read visitors for their property
    match /visitors/{visitorId} {
      allow read:   if isAuth() && ownsProperty(resource.data.propertyId);
      allow create: if isAuth() && ownsProperty(request.resource.data.propertyId)
                    && request.resource.data.registeredBy == request.auth.uid;
      allow update: if isAuth() && ownsProperty(resource.data.propertyId);
      allow delete: if isSuperAdmin();
    }

    // ============================================================
    // PRE-APPROVED VISITORS
    // ============================================================
    match /preApproved/{docId} {
      allow read:   if isAuth() && ownsProperty(resource.data.propertyId);
      allow create: if isSuperAdmin()
                    || (isPropertyStaff() && getPropertyId() == request.resource.data.propertyId)
                    || (isGuard() && getPropertyId() == request.resource.data.propertyId);
      allow update: if isSuperAdmin()
                    || (isPropertyStaff() && getPropertyId() == resource.data.propertyId)
                    || (isGuard() && getPropertyId() == resource.data.propertyId);
      allow delete: if isSuperAdmin() || (isPropertyStaff() && getPropertyId() == resource.data.propertyId);
    }

    // ============================================================
    // DELIVERIES
    // ============================================================
    match /deliveries/{deliveryId} {
      allow read:   if isAuth() && ownsProperty(resource.data.propertyId);
      allow create: if isAuth() && ownsProperty(request.resource.data.propertyId)
                    && request.resource.data.registeredBy == request.auth.uid;
      allow update: if isAuth() && ownsProperty(resource.data.propertyId);
      allow delete: if isSuperAdmin();
    }

    // ============================================================
    // INCIDENTS
    // ============================================================
    match /incidents/{incidentId} {
      allow read:   if isAuth() && ownsProperty(resource.data.propertyId);
      allow create: if isAuth() && ownsProperty(request.resource.data.propertyId);
      allow update: if isSuperAdmin() || (isPropertyStaff() && getPropertyId() == resource.data.propertyId);
      allow delete: if isSuperAdmin();
    }

    // ============================================================
    // SHIFTS
    // ============================================================
    match /shifts/{shiftId} {
      allow read:   if isAuth() && (ownsProperty(resource.data.propertyId) || request.auth.uid == resource.data.guardId);
      allow create: if isAuth() && ownsProperty(request.resource.data.propertyId);
      allow update: if isAuth() && (request.auth.uid == resource.data.guardId || isSuperAdmin() || isPropertyStaff());
      allow delete: if isSuperAdmin();
    }

    // ============================================================
    // SUBSCRIPTIONS
    // ============================================================
    // Guards cannot access subscription data
    match /subscriptions/{subId} {
      allow read:   if isAuth() && (isSuperAdmin() || (isPropertyStaff() && getPropertyId() == resource.data.propertyId));
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ============================================================
    // AUDIT LOGS
    // ============================================================
    // Immutable to all non-Super Admin users
    match /auditLogs/{logId} {
      allow read:   if isAuth() && (isSuperAdmin() || (isPropertyStaff() && getPropertyId() == resource.data.propertyId));
      allow create: if isAnyStaff()
                    && request.resource.data.actorId == request.auth.uid
                    && request.resource.data.actorRole == getRole()
                    && (isSuperAdmin() || request.resource.data.propertyId == getPropertyId()); // actor + property bound to claims
      allow update: if false;        // Nobody can edit audit logs
      allow delete: if false;        // Nobody can delete audit logs
    }

    // ============================================================
    // NOTIFICATIONS
    // ============================================================
    match /notifications/{notifId} {
      allow read:   if isAuth() && ownsProperty(resource.data.propertyId);
      allow create: if isAnyStaff() && ownsProperty(request.resource.data.propertyId);
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ============================================================
    // PLATFORM SETTINGS (pricing, default security posts)
    // ============================================================
    match /platform_settings/{doc} {
      allow read:  if isAuth();
      allow write: if isSuperAdmin();
    }

    // ============================================================
    // MAINTENANCE REQUESTS
    // ============================================================
    match /maintenance/{id} {
      allow read:   if isAuth() && ownsProperty(resource.data.propertyId);
      allow create: if isAuth() && ownsProperty(request.resource.data.propertyId);
      allow update: if isSuperAdmin() || (isPropertyStaff() && getPropertyId() == resource.data.propertyId)
                    || (isGuard() && getPropertyId() == resource.data.propertyId);
      allow delete: if isSuperAdmin() || (isPropertyStaff() && getPropertyId() == resource.data.propertyId);
    }

    // ============================================================
    // UNIT PAYMENTS
    // ============================================================
    match /payments/{id} {
      allow read:   if isAuth() && ownsProperty(resource.data.propertyId);
      allow create, update: if isSuperAdmin() || (isPropertyStaff() && getPropertyId() == request.resource.data.propertyId);
      allow delete: if isSuperAdmin();
    }

    // ============================================================
    // BLACKLIST
    // ============================================================
    match /blacklist/{id} {
      allow read:   if isAuth() && ownsProperty(resource.data.propertyId);
      allow create, update: if isSuperAdmin() || (isPropertyStaff() && getPropertyId() == request.resource.data.propertyId);
      allow delete: if isSuperAdmin() || (isPropertyStaff() && getPropertyId() == resource.data.propertyId);
    }

    // ============================================================
    // VEHICLE LOG
    // ============================================================
    match /vehicleLog/{id} {
      allow read:   if isAuth() && ownsProperty(resource.data.propertyId);
      allow create: if isAuth() && ownsProperty(request.resource.data.propertyId);
      allow update: if isAuth() && ownsProperty(resource.data.propertyId);
      allow delete: if isSuperAdmin();
    }

    // ============================================================
    // LEASES
    // ============================================================
    match /leases/{id} {
      allow read:   if isAuth() && ownsProperty(resource.data.propertyId);
      allow create, update: if isSuperAdmin() || (isPropertyStaff() && getPropertyId() == request.resource.data.propertyId);
      allow delete: if isSuperAdmin();
    }

    // ============================================================
    // COMPLAINTS
    // ============================================================
    match /complaints/{id} {
      allow read:   if isAuth() && ownsProperty(resource.data.propertyId);
      allow create: if isAuth() && ownsProperty(request.resource.data.propertyId);
      allow update: if isSuperAdmin() || (isPropertyStaff() && getPropertyId() == resource.data.propertyId);
      allow delete: if isSuperAdmin();
    }

    // ============================================================
    // UNIT INSPECTIONS
    // ============================================================
    match /inspections/{id} {
      allow read:   if isAuth() && ownsProperty(resource.data.propertyId);
      allow create, update: if isAuth() && ownsProperty(request.resource.data.propertyId);
      allow delete: if isSuperAdmin();
    }

    // ============================================================
    // TENANT INVITES
    // ============================================================
    match /tenantInvites/{token} {
      allow read:   if isSuperAdmin() || (isAuth() && ownsProperty(resource.data.propertyId));
      allow create: if isAuth() && isPropertyManager() && ownsProperty(request.resource.data.propertyId);
      allow update: if isSuperAdmin() || (isAuth() && ownsProperty(resource.data.propertyId));
      allow delete: if isSuperAdmin() || (isAuth() && ownsProperty(resource.data.propertyId));
    }

    // ============================================================
    // ADMIN ALERTS (written only by Cloud Functions; Super Admin reads/clears)
    // ============================================================
    match /adminAlerts/{alertId} {
      allow read: if isSuperAdmin();
      // Only allow marking as read — no other client field changes
      allow update: if isSuperAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false; // Cloud Functions use Admin SDK, bypassing this
    }

    // ============================================================
    // SALON MANAGEMENT
    // ============================================================

    function isSalonOwner() {
      return isAuth() && request.auth.token.role == 'SALON_OWNER';
    }

    function isSalonReceptionist() {
      return isAuth() && request.auth.token.role == 'SALON_RECEPTIONIST';
    }

    function isSalonProvider() {
      return isAuth() && request.auth.token.role == 'SALON_PROVIDER';
    }

    function isSalonStaff() {
      return isSalonOwner() || isSalonReceptionist() || isSalonProvider();
    }

    function isSalonOwnerOrReceptionist() {
      return isSalonOwner() || isSalonReceptionist();
    }

    // Caller belongs to this salon
    function ownsSalon(salonId) {
      return request.auth.token.salonId == salonId;
    }

    // Check whether a salon staff member's permissions doc grants a named permission.
    // If no permissions doc exists yet the staff member gets default access (backward compat).
    function staffHasPermission(uid, perm) {
      return !exists(/databases/$(database)/documents/salonStaffPermissions/$(uid))
             || get(/databases/$(database)/documents/salonStaffPermissions/$(uid)).data.get(perm, false) == true;
    }

    // Strict version: only grants access when permissions doc explicitly says true.
    // Used for sensitive fields (pricing, payments) where the default should be DENY.
    function staffHasPermissionStrict(uid, perm) {
      return exists(/databases/$(database)/documents/salonStaffPermissions/$(uid))
             && get(/databases/$(database)/documents/salonStaffPermissions/$(uid)).data.get(perm, false) == true;
    }

    // Receptionist permission check: falls back to true so existing receptionists
    // keep working before permissions are explicitly configured
    function receptionistMayCreateClients() {
      return isSalonReceptionist() && staffHasPermission(request.auth.uid, 'createClients');
    }

    match /salons/{salonId} {
      allow read: if isSuperAdmin() || (isSalonStaff() && ownsSalon(salonId));
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin() || (isSalonOwner() && ownsSalon(salonId));
    }

    match /salonProviders/{providerId} {
      allow read: if isSuperAdmin()
                  || (isSalonOwnerOrReceptionist() && ownsSalon(resource.data.salonId))
                  || (isSalonProvider() && request.auth.uid == providerId);
      allow create: if false; // Cloud Function only
      allow update: if isSuperAdmin() || (isSalonOwner() && ownsSalon(resource.data.salonId));
      allow delete: if isSuperAdmin();
    }

    match /salonClients/{clientId} {
      // Provider can read only if explicitly granted contact+name permissions (phone is in the doc)
      allow read: if isSuperAdmin()
                  || (isSalonOwnerOrReceptionist() && ownsSalon(resource.data.salonId))
                  || (isSalonProvider()
                      && ownsSalon(resource.data.salonId)
                      && staffHasPermission(request.auth.uid, 'viewClientName')
                      && staffHasPermission(request.auth.uid, 'viewPhone'));
      allow create: if receptionistMayCreateClients()
                    && ownsSalon(request.resource.data.salonId)
                    && request.resource.data.receptionistId == request.auth.uid;
      allow update: if isSuperAdmin()
                    || (isSalonOwner() && ownsSalon(resource.data.salonId))
                    || (isSalonReceptionist()
                        && ownsSalon(resource.data.salonId)
                        && staffHasPermission(request.auth.uid, 'editClients'));
      allow delete: if isSuperAdmin()
                    || (isSalonOwner() && ownsSalon(resource.data.salonId))
                    || (isSalonReceptionist()
                        && ownsSalon(resource.data.salonId)
                        && staffHasPermission(request.auth.uid, 'deleteClients'));
    }

    match /salonServices/{serviceId} {
      allow read: if isSuperAdmin()
                  || (isSalonOwnerOrReceptionist() && ownsSalon(resource.data.salonId))
                  || (isSalonProvider()
                      && ownsSalon(resource.data.salonId)
                      && resource.data.providerUid == request.auth.uid);
      allow create: if (isSalonReceptionist() || isSalonOwner())
                    && ownsSalon(request.resource.data.salonId)
                    && staffHasPermission(request.auth.uid, 'createBookings');
      allow update: if isSuperAdmin()
                    || (isSalonOwner() && ownsSalon(resource.data.salonId))
                    || (isSalonReceptionist()
                        && ownsSalon(resource.data.salonId)
                        && staffHasPermission(request.auth.uid, 'editBookings'))
                    || (isSalonProvider()
                        && ownsSalon(resource.data.salonId)
                        && resource.data.providerUid == request.auth.uid
                        && staffHasPermission(request.auth.uid, 'completeBookings'));
      allow delete: if isSuperAdmin();
    }

    // Pricing — provider can NEVER access; receptionist needs explicit viewPrices grant
    match /salonClientPricing/{clientId} {
      allow read: if isSuperAdmin()
                  || (isSalonOwner() && ownsSalon(resource.data.salonId))
                  || (isSalonReceptionist()
                      && ownsSalon(resource.data.salonId)
                      && staffHasPermission(request.auth.uid, 'viewPrices'));
      allow create: if (isSalonReceptionist() || isSalonOwner())
                    && ownsSalon(request.resource.data.salonId)
                    && staffHasPermission(request.auth.uid, 'viewPrices');
      allow update: if isSuperAdmin()
                    || (isSalonOwner() && ownsSalon(resource.data.salonId))
                    || (isSalonReceptionist()
                        && ownsSalon(resource.data.salonId)
                        && staffHasPermission(request.auth.uid, 'viewPrices'));
      allow delete: if isSuperAdmin();
    }

    match /salonPackages/{packageId} {
      allow read: if isSuperAdmin()
                  || (isSalonOwnerOrReceptionist() && ownsSalon(resource.data.salonId));
      allow create: if isSalonReceptionist() && ownsSalon(request.resource.data.salonId);
      allow update: if isSuperAdmin()
                    || (isSalonOwnerOrReceptionist() && ownsSalon(resource.data.salonId));
      allow delete: if isSuperAdmin();
    }

    // Checkouts — provider can NEVER access; receptionist needs explicit viewPayments grant
    match /salonCheckouts/{checkoutId} {
      allow read: if isSuperAdmin()
                  || (isSalonOwner() && ownsSalon(resource.data.salonId))
                  || (isSalonReceptionist()
                      && ownsSalon(resource.data.salonId)
                      && staffHasPermission(request.auth.uid, 'viewPayments'));
      allow create: if (isSalonReceptionist() || isSalonOwner())
                    && ownsSalon(request.resource.data.salonId)
                    && request.resource.data.receptionistId == request.auth.uid
                    && staffHasPermission(request.auth.uid, 'viewPayments');
      allow update: if isSuperAdmin()
                    || (isSalonOwner() && ownsSalon(resource.data.salonId));
      allow delete: if isSuperAdmin();
    }

    // ============================================================
    // SALON STAFF PERMISSIONS
    // ============================================================

    match /salonStaffPermissions/{uid} {
      allow read: if isSuperAdmin()
                  || (isSalonOwner() && ownsSalon(resource.data.salonId))
                  || (isAuth() && request.auth.uid == uid);
      // Writes only via Cloud Function (Admin SDK bypasses rules)
      allow write: if false;
    }

    match /salonPermissionAudit/{logId} {
      allow read: if isSuperAdmin()
                  || (isSalonOwner() && ownsSalon(resource.data.salonId));
      // Immutable — written only by Cloud Function
      allow write: if false;
    }

    // ============================================================
    // LEADS (public demo requests from the landing page)
    // ============================================================
    match /leads/{leadId} {
      allow read, delete: if isSuperAdmin();
      allow update: if isSuperAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow create: if request.resource.data.keys().hasOnly(
                         ['name','propertyName','propertyType','phone','email','message','source','status','createdAt'])
                    && request.resource.data.source == 'LANDING_FORM'
                    && request.resource.data.status == 'NEW'
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 120
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() > 0
                    && request.resource.data.phone.size() <= 20;
    }
  }
}
